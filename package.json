{
  "name": "dedrive",
  "version": "1.0.0",
  "private": true,
  "description": "Private Google Drive duplicate finder with read-only scanning and safe cleanup into a _dupes folder.",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this repo.'); process.exit(1); }\"",
    "dev": "node scripts/dev-server.mjs next dev",
    "build": "next build",
    "start": "node scripts/dev-server.mjs next start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "source-map-js": "1.2.2",
      "jsdom>undici": "8.12.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsilva/dedrive.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tsilva/dedrive/issues"
  },
  "homepage": "https://github.com/tsilva/dedrive#readme",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
